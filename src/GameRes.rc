/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDR_MAINFRAME           ICON    DISCARDABLE     "res\\MainFrame.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU PRELOAD DISCARDABLE 
BEGIN
    POPUP "&Game"
    BEGIN
        MENUITEM "&New\tF2",                    ID_GAME_NEW
        MENUITEM "&Pause\tF3",                  ID_GAME_PAUSE
        MENUITEM "&End\tF4",                    ID_GAME_END
        MENUITEM SEPARATOR
        MENUITEM "E&xit\tAlt-F4",               ID_APP_EXIT
    END
    POPUP "&Options"
    BEGIN
        MENUITEM "&Speed...\tF5",               ID_OPTIONS_SPEED
        MENUITEM "&Level...\tF6",               ID_OPTIONS_LEVEL
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&High Scores...\tF7",         ID_VIEW_SCORES
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "Instructions and tips",       ID_HELP_README
        MENUITEM "License information (GNU)",   ID_HELP_LICENSE
        MENUITEM SEPARATOR
        MENUITEM "&About...\tF1",               ID_HELP_ABOUT
    END
END


