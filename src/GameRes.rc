/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_HELP_ABOUT DIALOG DISCARDABLE  0, 0, 222, 90
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About Xonix32"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Web:  http://www.mindspring.com/~xonix",IDC_STATIC,40,5,175,8
    LTEXT           "Email:  xonix@mindspring.com",IDC_STATIC,40,15,175,8
    LTEXT           "<<< version string goes here >>>",IDC_TEXT_VERSION,40,
                    25,175,8
    LTEXT           "Copyright (C) 1997-1998  Shawn A. VanNess",IDC_STATIC,
                    40,35,175,8
    LTEXT           "Based on the original game by XPARC (???)",IDC_STATIC,
                    40,45,175,8
    LTEXT           "See gnu_license.txt for copyright and redistribution info",
                    IDC_STATIC,40,55,175,8
    ICON            IDR_MAINFRAME,IDC_STATIC,10,25,20,20
    DEFPUSHBUTTON   "OK",IDOK,80,70,55,14,BS_CENTER | BS_VCENTER
END

IDD_OPT_SPEED DIALOG DISCARDABLE  0, 0, 182, 90
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Set Game Speed"
FONT 8, "MS Sans Serif"
BEGIN
    CONTROL         "Slider1",IDC_SLIDER_SPEED,"msctls_trackbar32",
                    TBS_AUTOTICKS | TBS_TOP | WS_TABSTOP,15,30,151,19
    DEFPUSHBUTTON   "OK",IDOK,35,60,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,100,60,50,14
    CTEXT           " 10 fps",IDC_STATIC,15,20,22,8
    CTEXT           " 30 fps",IDC_STATIC,80,20,22,8
    CTEXT           " 50 fps",IDC_STATIC,145,20,22,8
    CTEXT           "100 pts",IDC_STATIC,15,10,24,8
    CTEXT           "300 pts",IDC_STATIC,80,10,24,8
    CTEXT           "500 pts",IDC_STATIC,145,10,24,8
END

IDD_OPT_LEVEL DIALOG DISCARDABLE  0, 0, 147, 61
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Set Starting Level"
FONT 8, "MS Sans Serif"
BEGIN
    EDITTEXT        IDC_EDIT1,22,20,33,15,ES_AUTOHSCROLL
    CONTROL         "Spin2",IDC_SPIN_LEVEL,"msctls_updown32",UDS_SETBUDDYINT | 
                    UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | 
                    UDS_NOTHOUSANDS,50,20,11,15
    DEFPUSHBUTTON   "OK",IDOK,85,10,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,85,30,50,14
    LTEXT           "Level:",IDC_STATIC,25,10,20,8
END

IDD_HIGH_SCORES DIALOG DISCARDABLE  0, 0, 137, 116
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "High Scores"
FONT 8, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,40,95,50,15
    LISTBOX         IDC_LIST_RANK,5,7,20,83,NOT LBS_NOTIFY | 
                    LBS_NOINTEGRALHEIGHT | WS_TABSTOP
    LISTBOX         IDC_LIST_NAME,25,7,75,83,NOT LBS_NOTIFY | 
                    LBS_NOINTEGRALHEIGHT | WS_TABSTOP
    LISTBOX         IDC_LIST_SCORE,100,7,30,83,NOT LBS_NOTIFY | 
                    LBS_NOINTEGRALHEIGHT | WS_TABSTOP
END

IDD_NEWHIGHSCORE DIALOG DISCARDABLE  0, 0, 122, 66
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "New High Score!"
FONT 8, "MS Sans Serif"
BEGIN
    EDITTEXT        IDC_EDIT_NAME,10,25,100,15,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK",IDOK,35,45,50,14
    LTEXT           "Enter your name, cowboy.",IDC_STATIC,10,15,100,8
    LTEXT           "Your score is in the top ten!",IDC_STATIC,10,5,100,8
END


